*.swp
*.swo
*~

# OS
Thumbs.db
ehthumbs.db
Desktop.ini

# Logs
logs/
*.log

# Turbo
.turbo/

# Build artifacts
dist/
*.tsbuildinfo

# Cache
.cache/
.eslintcache
.stylelintcache

# Temporary files
*.tmp
*.temp
tmp/
temp/

# MCP
.mcp-runtime.json

# Vercel
.vercel/output/
.vercel

# ---------------------------------------------------------------------------
# Workspace transient subdirectories (NOT committed)
#
# Per GOVERNANCE.md Rule 2, .workspace/ is a development artifact area.
# These subdirectories hold scratch/session/temporary data and are transient.
#
# NOTE: .workspace/PRI/ and .workspace/LFI/ are INTENTIONALLY NOT IGNORED.
# The PRI and LFI are durable structural + behavioral reference systems that
# MUST be committed so any agent (or human) can understand the project
# without manually walking the entire tree. See .workspace/README.md.
# ---------------------------------------------------------------------------
.workspace/ai/
.workspace/sessions/
.workspace/temp/
.workspace/logs/
.workspace/generated/
.workspace/reports/
.workspace/research/
.workspace/planning/
.workspace/validation/
.vercel
.env*
